# Standalone extension: the worker-thread POOL — a thin, platform-agnostic
# composition on the threading PRIMITIVE (the concern). This is the "give me a
# pool of workers and a batch barrier" layer the application links against; the
# primitive (opaque thread handle + the hardware facts) is the concern it
# requires, and the jobs system (the frame-scoped surface on this pool) is the
# layer on top.
#
# It is a STANDALONE (kind = "standalone"), not a concern: the pool's LOGIC
# (the batch dispatch + the barrier + the auto-sizing) is platform-agnostic —
# it builds on the platform-varying primitive (Thread_Create/Thread_Join + the
# hardware facts), so there is no capability-level platform variation to model
# as an interface/implementation split. A single source serves every platform;
# the platform branches are the low-level lock/cond and the barrier's wait
# strategy (block on native, spin on the web main thread, which cannot block).
#
# THE BATCH DISPATCH (the 2.0.0 major over the original FIFO linked-list queue
# — a per-job heap node + one shared lock + a per-job signal):
# (1) a per-batch MODE (TPMode): LANES (the performant default; each worker
# runs its round-robin lane, no stealing, no shared hot state) or STEAL (the
# expert mode for skewed distributions; per-worker private lock-free Chase-Lev
# deques + cross-worker stealing — measured ~8x where lanes stall at ~1.1x on
# the lopsided bench); SubmitSlot is the distribution seam; (2) the ALLOCATOR
# SEAM (TPAllocator): the pool never assumes who owns job-node memory — the
# caller hands it an allocator (a hot arena: Claim/no-op-free/bulk-reset; a
# polyglot caller's own allocator over the ABI) or the memory concern directly
# (Create; the general case — the arena is an optional concern). The served
# struct is append-only (an older consumer's table copy keeps working: new
# members are appended, never reordered): SetMode, SubmitSlot, and
# CreateWithAllocator extend the original operations.
#
# Sizing: Create(n) / CreateWithAllocator(n, allocator) with n <= 0 (auto)
# sizes to the hardware's PHYSICAL core count (Thread_Count_Physical — exact on
# native, an honest estimate on web), clamped to the concurrency ceiling
# (Thread_Concurrency). n > 0 is an explicit override, clamped to the ceiling.
# A ceiling of 0 (threading_none, or an Emscripten page without
# SharedArrayBuffer) degrades the pool to SERIAL (jobs run inline on the
# submitting thread, no workers, no job memory at all) — the degradation is
# keyed off the primitive's concurrency fact, so the pool stays
# platform-agnostic.
#
format_version = 1
name   = "thread_pool"
kind   = "standalone"
version        = "2.0.0"
requires = [
  { package = "threading", window = "1.0.0" },
  { package = "memory", window = "1.1.0" },
  { package = "logging", window = "1.1.0" },
]
# The contract renderings this package ships (the dialect-table membership
# fact; the cradle is the cross-check, a drift is a named refusal).
renderings = ["static", "dynamic"]
